// ─────────────────────────────────────────────────────────────────────────────
//  Kysland — config (JSON with comments, reloaded on every save)
//  Folder: %USERPROFILE%\.config\kysland\   (config.jsonc, style.css)
// ─────────────────────────────────────────────────────────────────────────────
{
  "language": "auto",           // "auto" (Windows display language) | "en" | "fr"
  "position": "top",            // "top" | "bottom"
  "height": 32,                 // height reserved at the top of the screen (= notch height)
  "reserve": false,              // true: maximized windows stop below the notch
                                // false: the notch floats above windows (iPhone style)
  "monitors": "primary",        // "all" | "primary" | [0, 1] (screens sorted left to right)
  "hide-on-fullscreen": true,    // hides the notch while an app is fullscreen (game, video, F11)
  "wallpaper": null,            // e.g. "~/Pictures/wall.jpg"

  // Just the notch. For a full Waybar-style bar, add modules
  // on the left / right (see the list below).
  "modules-left": [],
  "modules-center": ["island"],
  "modules-right": [],

  // ── The notch ──────────────────────────────────────────────────────────────
  //  At rest: time + date (+ album art and equalizer while music plays)
  //  Hover: expands → music (controls, clickable progress), CPU, RAM, network, volume
  //  Mouse wheel: volume. Right click: Kysland menu (also Ctrl+Alt+W).
  "island": {
    "time-format": "HH:mm",              // dayjs formats: https://day.js.org/docs/en/display/format
    "date-format": "ddd D MMM",
    "date-long-format": "dddd D MMMM",
    "expand-on-hover": true,
    "hover-delay": 120,                  // ms before expanding
    "collapse-delay": 350,               // ms before collapsing
    "media-linger": 15,                  // seconds a paused track stays visible
    "outline": "auto",                   // thin outline when it's mostly black around the notch; true / false to force it
    "dodge": true,                       // approach slowly and the notch tucks itself away (to reach what's behind); fast = hover as usual
    "dodge-speed": 450,                  // px/s: approaches slower than this count as slow
    "dodge-eyes": true,                  // two little eyes watch the cursor while it's hidden
    "dodge-roam": true,                  // cursor still close after a while: the notch grows and the eyes roam around
    "dodge-roam-delay": 20,              // seconds
    "peek": true,                        // now and then, the eyes squeeze into the notch to check on the mouse; rush at them and they flee
    "kys-brain": "simple",               // talking to Kys: "simple" (commands and a few phrases), or a small AI on your PC, downloaded from the settings: "light" (fast) or "smart" (much better company)
    "auto-hide": false,                  // hides while the mouse is far away or on another screen; comes back as it gets near
    "auto-hide-distance": 300,           // px around the notch where it comes back
    "hide-windows-osd": true,           // volume keys no longer show the Windows flyout (Kysland handles them)
    "volume-step": 2,                   // % per volume key press
    "notifications": true,              // Windows notifications shown in the notch
    "notification-duration": 6,         // seconds (hover: pause, click: next, right click: clear all)
    "claude": false,                     // Claude plan usage (5 h session / week), if Claude Code is installed
    "kemhome": "http://localhost:8080",  // KemHome agent (Chrome extension, album art); false to disable
    // Events that stretch the notch for a few seconds:
    "transients": { "volume": true, "media": true, "battery": true, "network": true, "workspace": true }
  },

  // ── Modules for a full bar (optional) ──────────────────────────────────────
  //  launcher, workspaces (GlazeWM), mode, window, clock, cpu, memory, disk,
  //  network, audio, battery, media, power, custom/<name>
  //  Example:
  //    "modules-left": ["launcher", "workspaces", "window"],
  //    "modules-right": ["network", "cpu", "memory", "audio", "power"],
  //
  //  Formats: {key}, {i:lucide-icon} (https://lucide.dev/icons), {icon}
  //  Mouse actions: "shell command" or "@open <url>", "@audio up", "@media next",
  //  "@power lock", "@glaze <command>", "@start-menu", "@toggle", "@reload"

  "workspaces": {
    "persistent-workspaces": ["1", "2", "3", "4", "5"]
  },
  "window": {
    "max-length": 55,
    "rewrite": { "(.*) - Google Chrome": "$1" }
  },
  "custom/weather": {
    "exec": "curl -s \"https://wttr.in/?format=%c%t\"",
    "interval": 900,
    "on-click": "@open https://wttr.in"
  }
}
