{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kysland",
  "version": "0.1.3",
  "identifier": "com.kinjer.kysland",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/vendor.js",
    "beforeBuildCommand": "node scripts/vendor.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.config/kysland/**", "$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kinjer",
    "copyright": "© 2026 Kinjer",
    "shortDescription": "Dynamic Island pour Windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../defaults/*": "defaults/",
      "../themes/*": "themes/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
